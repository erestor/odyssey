<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>
	<ItemGroup>
		<Content Update="
			wwwroot/App/**/*;
			wwwroot/Styles/**/*.less;
			wwwroot/Styles/site.css;
			wwwroot/Tests/**/*;
			wwwroot/Gruntfile.js;
			wwwroot/package.json;
			wwwroot/package-lock.json" CopyToPublishDirectory="Never" />
	</ItemGroup>
	<ItemGroup>
		<Content Update="wwwroot/App/build/**/*" CopyToPublishDirectory="Always" />
	</ItemGroup>
	<Target Name="NpmInstall" BeforeTargets="RunGruntDebug;RunGruntRelease" Condition="!Exists('$(ProjectDir)wwwroot\node_modules')">
		<Exec Command="cd /d $(ProjectDir)\wwwroot &amp;&amp; npm install" />
	</Target>
	<Target Name="RunGruntDebug" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<Exec Command="cd /d $(ProjectDir)\wwwroot &amp;&amp; npx grunt debug" />
	</Target>
	<Target Name="RunGruntRelease" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(_IsPublishing)' != 'yes'">
		<Exec Command="cd /d $(ProjectDir)\wwwroot &amp;&amp; npx grunt release" />
	</Target>
</Project>
